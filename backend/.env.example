NODE_ENV=development
PORT=5000

MONGODB_URI=mongodb://localhost:27017/resqconnect
MONGODB_TEST_URI=mongodb://localhost:27017/resqconnect_test

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-to-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7

ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000

SMTP_HOST=smtp.gmail.com
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-app-password
EMAIL_FROM=noreply@resqconnect.app
EMAIL_FROM_NAME=ResQconnect

TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+10000000000

# Optional external ML service — leave ML_MODEL_URL blank to use the rule-based model only
ML_MODEL_URL=
ML_MODEL_TIMEOUT_MS=3000
ML_MODEL_API_KEY=

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

BCRYPT_ROUNDS=12

LOG_LEVEL=debug